    {
      "parameters": {
        "promptType": "define",
        "text": "=You classify a public news article for a personalized newsletter.\n\nTitle: {{ $json.title }}\nDescription: {{ $json.description }}\n\nWrite a neutral English summary of at most 60 words using only information present above. Select exactly one primary topic from this list only: technology, business, science, world, politics, health, sports, environment, culture. Do not infer personal data and do not invent facts.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
