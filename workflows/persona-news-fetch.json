      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const row = $input.first()?.json || {};\nconst requestedMode = String(row.mode || '').trim().toLowerCase();\nconst mode = requestedMode === 'topup' ? 'topup' : (requestedMode === 'scheduled' || row.timestamp ? 'scheduled' : 'manual');\nconst requestedMax = Number(row.max_items);\nconst maxItems = mode === 'topup'\n  ? Math.min(20, Math.max(1, Number.isInteger(requestedMax) ? requestedMax : 20))\n  : 10;\nreturn [{ json: { ...row, mode, max_items: maxItems } }];"
