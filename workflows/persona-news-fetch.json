    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"summary\":{\"type\":\"string\",\"description\":\"Neutral English summary of at most 60 words\"},\"topic\":{\"type\":\"string\",\"enum\":[\"technology\",\"business\",\"science\",\"world\",\"politics\",\"health\",\"sports\",\"environment\",\"culture\"]}},\"required\":[\"summary\",\"topic\"],\"additionalProperties\":false}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        2240,
        160
      ],
      "id": "d006eae5-4a92-48bb-b599-f4f23740ca89",
      "name": "Article Output Schema"
    },
    {
      "parameters": {
        "jsCode": "const sourceItems = $('Limit AI Batch').all();\nconst allowed = ['technology', 'business', 'science', 'world', 'politics', 'health', 'sports', 'environment', 'culture'];\nconst rules = {\n  technology: ['technology', 'software', 'computer', 'internet', 'cyber', 'microsoft', 'google', 'apple', 'ai ', 'artificial intelligence'],\n  business: ['business', 'economy', 'economic', 'finance', 'market', 'company', 'bank', 'trade'],\n  science: ['science', 'research', 'space', 'physics', 'biology'],\n  politics: ['government', 'president', 'minister', 'election', 'parliament', 'politic'],\n  health: ['health', 'hospital', 'medical', 'doctor', 'disease'],\n  sports: ['sport', 'football', 'tennis', 'match', 'league'],\n  environment: ['climate', 'environment', 'emission', 'wildlife'],\n  culture: ['culture', 'film', 'music', 'art', 'book']\n};\nconst inferTopic = (value) => {\n  const text = String(value).toLowerCase();\n  for (const topic of allowed) {\n    if ((rules[topic] || []).some((word) => text.includes(word))) return topic;\n  }\n  return 'world';\n};\nreturn $input.all().map((item, index) => {\n  const source = sourceItems[index]?.json || {};\n  const candidate = item.json.output && typeof item.json.output === 'object' ? item.json.output : item.json;\n  let summary = typeof candidate.summary === 'string' ? candidate.summary.trim() : '';\n  const legacyTopic = Array.isArray(candidate.topics) ? candidate.topics[0] : '';\n  let topic = String(candidate.topic || legacyTopic || '').toLowerCase().trim();\n  if (!allowed.includes(topic)) topic = '';\n  const fallback = Boolean(item.json.error) || !summary || !topic;\n  if (!summary) summary = String(source.description || source.title || '').trim().slice(0, 500);\n  if (!topic) topic = inferTopic(`${source.title || ''} ${source.description || ''}`);\n  return { json: {\n    ...source,\n    summary: summary.slice(0, 700),\n    topics_json: JSON.stringify([topic]),\n    ai_status: fallback ? 'fallback' : 'groq',\n    updated_at: new Date().toISOString()\n  } };\n});"
      },
