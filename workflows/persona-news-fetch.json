    {
      "parameters": {
        "jsCode": "return [\n  { json: { source: 'BBC Technology', feed_url: 'https://feeds.bbci.co.uk/news/technology/rss.xml' } },\n  { json: { source: 'TechCrunch', feed_url: 'https://techcrunch.com/feed/' } },\n  { json: { source: 'The Guardian World', feed_url: 'https://www.theguardian.com/world/rss' } },\n  { json: { source: 'Bloomberg Markets', feed_url: 'https://feeds.bloomberg.com/markets/news.rss' } },\n  { json: { source: 'The New York Times', feed_url: 'https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml' } }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "a1fc7d20-eb53-4aa4-b4e5-e249f08c934b",
      "name": "Define RSS Sources"
    },
    {
      "parameters": {
        "url": "={{ $json.feed_url }}",
        "options": {}
      },
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "position": [
        720,
        0
      ],
      "id": "67380328-3c3f-4f55-a81c-0da0b0077c2a",
      "name": "Read RSS Feeds",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const cleanText = (value) => String(value ?? '')\n  .replace(/<[^>]*>/g, ' ')\n  .replace(/&nbsp;/gi, ' ')\n  .replace(/&amp;/gi, '&')\n  .replace(/&quot;/gi, '\\\"')\n  .replace(/&#39;/gi, \"'\")\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst canonicalUrl = (value) => {\n  const withoutHash = String(value).trim().split('#')[0];\n  const parts = withoutHash.split('?');\n  let base = parts.shift();\n  if (!/^https?:\\/\\//i.test(base)) throw new Error('Invalid URL');\n  base = base.replace(/\\/+$/, '');\n  const parameters = parts.join('?').split('&').filter(Boolean).filter((pair) => {\n    const key = pair.split('=')[0].toLowerCase();\n    return !key.startsWith('utm_') && !['fbclid', 'gclid'].includes(key);\n  }).sort();\n  return base + (parameters.length ? '?' + parameters.join('&') : '');\n};\n\nconst sourceName = (value) => {\n  const match = String(value).match(/^https?:\\/\\/([^/]+)/i);\n  const host = (match ? match[1] : '').replace(/^www\\./, '').toLowerCase();\n  if (host.includes('bbc.')) return 'BBC Technology';\n  if (host.includes('techcrunch.com')) return 'TechCrunch';\n  if (host.includes('theguardian.com')) return 'The Guardian World';\n  if (host.includes('bloomberg.com')) return 'Bloomberg Markets';\n  if (host.includes('nytimes.com')) return 'The New York Times';\n  return host;\n};\n\nconst now = new Date().toISOString();\nconst output = [];\nfor (const item of $input.all()) {\n  const article = item.json;\n  if (article.error || !article.link || !article.title) continue;\n  let url;\n  try { url = canonicalUrl(article.link); } catch { continue; }\n  const rawDate = article.isoDate || article.pubDate || article.published || article.date || '';\n  const parsedDate = rawDate ? new Date(rawDate) : null;\n  const publishedAt = parsedDate && !Number.isNaN(parsedDate.getTime()) ? parsedDate.toISOString() : '';\n  const description = cleanText(article.contentSnippet || article.description || article.summary || article.content || '').slice(0, 5000);\n  output.push({ json: {\n    url,\n    title: cleanText(article.title).slice(0, 1000),\n    description,\n    source: sourceName(url),\n    published_at: publishedAt,\n    fetched_at: now,\n    updated_at: now\n  } });\n}\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
